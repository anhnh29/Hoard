{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter @hoard/api build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @hoard/api start:prod",
    "healthcheckPath": "/health"
  }
}
